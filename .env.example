# Salin file ini menjadi .env dan isi dengan kredensial Firebase Anda
# Dapatkan di: Firebase Console → Project Settings → General → Your apps → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# VAPID Key untuk Web Push Notification
# Dapatkan di: Firebase Console → Project Settings → Cloud Messaging → Web configuration
VITE_FIREBASE_VAPID_KEY=
